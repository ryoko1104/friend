

<!-- 2. タイトルと新規投稿ボタン -->
<div class="title-container">
  <h3>＜ 一覧ページ ＞</h3>
  
</div>

<!-- 3. 中央の検索バー -->
<div class="search-container">
  <%= form_tag({controller:"tweets", action:"index"}, method: :get) do %>
    <%= text_field_tag :search, params[:search], placeholder: "キーワード検索..." %>
    <%= submit_tag '検索' %>
  <% end %>
</div>

<!-- 4. 投稿一覧（手書き図通りのレイアウト） -->
<div class="tweets-container">
  <% @tweets.each do |t| %>
    <div class="tweet">

      <!-- 右側の写真 -->
      <% if t.image.attached? %>
        <%= image_tag t.image %>
      <% end %>

      <!-- 左側のテキスト＆操作エリア -->
      <div class="tweet-content">
        <!-- 名前 -->
        <p class="tweet-name">名前：<%= t.name %></p>

        <!-- ▷ 詳しくみる -->
        <%= link_to "▷ 詳しくみる", tweet_path(t.id), class: "detail-link" %>

        <!-- 丸囲みの 編集 / 削除 ボタン -->
        <div class="action-buttons">
          <%= link_to "編集", edit_tweet_path(t.id), class: "btn-edit" %>
          <%= button_to "削除", tweet_path(t.id), method: :delete, class: "btn-delete" %>
        </div>
      </div>

    </div>
  <% end %>
</div>