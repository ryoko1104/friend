<div class="signup-page">

  <h2>新規登録</h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render "users/shared/error_messages", resource: resource %>

    <div class="field">
      <%= f.label :name, "名前" %>
      <%= f.text_field :name, autofocus: true, placeholder: "山田 太郎" %>
    </div>

    <div class="field">
      <%= f.label :email, "メールアドレス" %>
      <%= f.email_field :email, autocomplete: "email", placeholder: "example@email.com" %>
    </div>

    <div class="field">
      <%= f.label :password, "パスワード" %>
      <% if @minimum_password_length %>
        <span class="password-note">（<%= @minimum_password_length %>文字以上）</span>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password", placeholder: "パスワードを入力" %>
    </div>

    <div class="field">
      <%= f.label :password_confirmation, "パスワード（確認用）" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "もう一度入力" %>
    </div>

    <div class="submit-box">
      <%= f.submit "新規登録" %>
    </div>
  <% end %>

  <div class="devise-links">
    <%= link_to "すでにアカウントをお持ちの方はこちら（ログイン）", new_session_path(resource_name), class: "link-item" %>
  </div>

</div>