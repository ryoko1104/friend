<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Friend" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="main-header">
      <div class="header-inner">
        <h1>
          <%= image_tag "logo.png", class: "header-logo", alt: "ロゴ" %>
          <span>友達登録サイト</span>
        </h1>
        
        <div class="header-list">
          <ul>
            <% if user_signed_in? %>
              <!-- ログイン状態 -->
              <li><%= button_to 'ログアウト', destroy_user_session_path, method: :delete, class: "header-link-btn" %></li>
              <li><%= link_to "マイページへ", user_path(current_user), class: "header-link" %></li>
              <li><%= link_to "新規投稿へ", new_tweet_path, class: "header-btn-highlight" %></li>
            <% else %>
              <!-- ログアウト状態 -->
              <li><%= link_to "新規登録", new_user_registration_path, class: "header-link" %></li>
              <li><%= link_to "ログイン", new_user_session_path, class: "header-link" %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </header>

    <main>
      <!-- フラッシュメッセージ（メール送信完了などの通知表示エリア） -->
      <% if notice %>
        <div class="flash-notice"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="flash-alert"><%= alert %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>