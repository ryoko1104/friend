<div class="new-tweet-page">
  <h3>新規投稿ページ</h3>

  <%= form_for @tweet do |f| %>

    <div class="field">
      <%= f.label :name, "名前" %>
      <%= f.text_field :name, size: 30 %>
    </div>

    <div class="field">
      <%= f.label :age, "年齢" %>
      <%= f.number_field :age, size: 10 %>
    </div>

    <div class="field">
      <%= f.label :community, "コミュニティー" %>
      <%= f.text_field :community, size: 30 %>
    </div>

    <div class="field">
      <%= f.label :birthday, "誕生日" %>
      <%= f.date_field :birthday %>  
    </div>

    <div class="field">
      <%= f.label :image, "写真" %>
      <%= f.file_field :image %>
    </div>

    <div class="field">
      <%= f.label :personality, "性格・特徴" %>
      <%= f.text_area :personality, size: "30x2" %>
    </div>

    <div class="field">
      <%= f.label :birthplace, "出身地" %>
      <%= f.text_field :birthplace, size: 30 %>
    </div>

    <%= f.submit "投稿する" %>

  <% end %>

  <%= link_to "一覧に戻る", tweets_path %>
</div>