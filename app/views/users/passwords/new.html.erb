<div class="password-reset-page">

  <h2>パスワードをお忘れの方</h2>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
    <%= render "users/shared/error_messages", resource: resource %>

    <div class="field">
      <%= f.label :email, "メールアドレス" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "example@email.com" %>
    </div>

    <div class="submit-box">
      <%= f.submit "再設定用メールを送る" %>
    </div>
  <% end %>

  <div class="devise-links">
    <%= link_to "ログイン画面へ戻る", new_session_path(resource_name), class: "link-item" %>
    <%= link_to "新規登録はこちら", new_registration_path(resource_name), class: "link-item" %>
  </div>

</div>