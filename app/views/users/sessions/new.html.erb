<div class="login-page">

  <h2>ログイン</h2>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="field">
      <%= f.label :email, "メールアドレス" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "example@email.com" %>
    </div>

    <div class="field">
      <%= f.label :password, "パスワード" %>
      <%= f.password_field :password, autocomplete: "current-password", placeholder: "パスワードを入力" %>
    </div>

    <div class="submit-box">
      <%= f.submit "ログイン" %>
    </div>
  <% end %>

  <div class="devise-links">
    <%= link_to "新規登録はこちら", new_registration_path(resource_name), class: "link-item" %>
    <%= link_to "パスワードをお忘れの方はこちら", new_password_path(resource_name), class: "link-item" %>
  </div>

</div>